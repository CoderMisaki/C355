{
  "manifest_version": 3,
  "name": "ChessMint",
  "short_name": "ChessMint",
  "version": "3.0.1",
  "description": "Advanced Chess Assistant Extension",
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["chessmint.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ]
}
