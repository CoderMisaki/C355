{
  "manifest_version": 3,
  "name": "ChessMint",
  "short_name": "ChessMint",
  "version": "2.0.0",
  "description": "Chess.com assistant",
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["loader.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["chessmint.js"],
      "matches": ["https://www.chess.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ]
}
