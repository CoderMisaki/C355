{
  "manifest_version": 3,
  "name": "ChessMint Pro",
  "short_name": "ChessMint",
  "version": "3.1.0",
  "description": "Advanced Real-time Chess Engine Assistant",
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["chessmint.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["stockfish.js"],
      "matches": ["https://www.chess.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ]
}
