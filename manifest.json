{
  "manifest_version": 3,
  "name": "ChessMint - Game Assistant",
  "short_name": "ChessMint",
  "version": "2.0.0",
  "description": "Modern game analysis and move helper for Chess.com",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ]
}
