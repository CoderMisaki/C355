{
  "manifest_version": 3,
  "name": "ChessMint Pro",
  "short_name": "ChessMint",
  "version": "3.2.0",
  "description": "Advanced Real-time Chess Engine Assistant",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["chessmint.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "stockfish.js",
        "styles.css"
      ],
      "matches": ["*://*.chess.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ]
}
