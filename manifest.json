{
  "manifest_version": 3,
  "name": "ChessMint - Game Assistant",
  "short_name": "ChessMint",
  "version": "2.0.0",
  "description": "Modern game analysis helper for Chess.com",
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ]
}
